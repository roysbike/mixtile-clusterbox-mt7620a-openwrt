<p class="luci">
	{% if (version.mixtile): %}
	<a href="{{ entityencode(version.mixtile.url ?? '#', true) }}" target="_blank" rel="noreferrer">{{ version.mixtile.name }}
		· Firmware {{ version.mixtile.version }}
		· commit {{ version.mixtile.commit }}{% if (version.mixtile.protocol): %}
		· OpenMIOP v{{ version.mixtile.protocol }}{% endif %}</a> /
	{% endif %}
	Powered by {{ version.luciname }} ({{ version.luciversion }})
</p>

<script type="text/javascript">L.require('menu-openwrt2020')</script>

</body>
</html>
