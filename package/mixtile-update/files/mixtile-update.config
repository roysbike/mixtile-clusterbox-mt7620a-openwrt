config updater 'main'
	# rc: newest release including release candidates; stable: final
	# releases only. Empty: UPDATE_CHANNEL from /etc/mixtile-release.
	option channel ''
	# GitHub owner/repo of the release source. Empty: REPOSITORY from
	# /etc/mixtile-release (the repository the firmware was built from).
	option repository ''
	option api 'https://api.github.com'
	# 1: refuse releases without a valid SHA256SUMS.sig. A signature is
	# always checked when /etc/mixtile-update/keys/ holds a usign key.
	option require_signature '0'
