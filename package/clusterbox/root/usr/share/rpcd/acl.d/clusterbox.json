{
	"clusterbox": {
		"description": "ClusterBox BMC management: topology, access, services, configuration history",
		"read": {
			"ubus": {
				"clusterbox": [ "topology", "admin_get", "pending", "history_list", "history_files", "history_file" ],
				"nodectl": [ "status", "log", "console_log", "leases", "pubkey" ]
			},
			"uci": [ "clusterbox", "nodectl" ]
		},
		"write": {
			"ubus": {
				"clusterbox": [ "admin_set", "confirm", "history_snapshot", "history_restore", "history_delete", "apply" ],
				"nodectl": [ "action", "rescan", "console", "send", "fan" ]
			},
			"uci": [ "clusterbox", "nodectl" ]
		}
	}
}
