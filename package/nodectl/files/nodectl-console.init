#!/bin/sh /etc/rc.common
# Serial console servers: one `nodectl consoled` per node keeps the UART open,
# logs it to /var/log/nodectl/consoleN.log and lets several clients share it.

START=16
STOP=85
USE_PROCD=1

start_service() {
	local n enabled baud tty log_kb

	config_load nodectl
	config_get_bool enabled global console 1
	[ "$enabled" = 1 ] || return 0
	config_get log_kb global console_log_kb

	for n in 1 2 3 4; do
		config_get_bool enabled "node$n" console 1
		[ "$enabled" = 1 ] || continue
		config_get baud "node$n" baud
		config_get tty "node$n" tty
		procd_open_instance "node$n"
		procd_set_param command /bin/nodectl consoled -n "$n"
		# Not read by nodectl; makes procd restart the instance when they change.
		procd_set_param env "BAUD=$baud" "TTY=$tty" "LOG_KB=$log_kb"
		procd_set_param respawn 3600 5 0
		procd_set_param stderr 1
		procd_close_instance
	done
}

service_triggers() {
	procd_add_reload_trigger nodectl
}
