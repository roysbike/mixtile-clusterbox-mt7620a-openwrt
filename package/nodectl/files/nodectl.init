#!/bin/sh /etc/rc.common

START=15
STOP=20

NODECTL=/bin/nodectl

autostart_nodes() {
	local n autostart

	for n in 1 2 3 4; do
		config_get_bool autostart "node$n" autostart 1
		[ "$autostart" = 1 ] && echo "$n"
	done
}

schedule_rescan() {
	local delay

	config_get delay global rescan_delay 45
	[ "$delay" -gt 0 ] 2>/dev/null || return 0
	( sleep "$delay"; $NODECTL rescan ) >/dev/null 2>&1 &
}

start() {
	local action n

	config_load nodectl
	config_get action global boot_action poweron

	case "$action" in
	cycle)
		for n in $(autostart_nodes); do
			$NODECTL reboot --hard -n "$n"
		done
		;;
	poweron)
		for n in $(autostart_nodes); do
			$NODECTL poweron -n "$n"
			sleep 1
		done
		;;
	*)
		$NODECTL status >/dev/null
		;;
	esac

	schedule_rescan
}

stop() {
	local action

	config_load nodectl
	config_get action global stop_action none

	case "$action" in
	shutdown)
		$NODECTL shutdown --all --force
		;;
	poweroff)
		$NODECTL poweroff --all
		;;
	esac
}
