config global 'global'
	# What to do with nodes when the ClusterBox boots: keep | poweron | cycle
	option boot_action 'poweron'
	# What to do with nodes when the ClusterBox stops: none | shutdown | poweroff
	option stop_action 'none'
	# Seconds after boot before rescanning PCIe for nodes (0 disables)
	option rescan_delay '60'
	# Power button press length, ms (force_press_ms forces the PMIC off)
	option press_ms '500'
	option force_press_ms '8000'
	option reset_ms '200'
	# Graceful shutdown: max wait, and extra wait after the node stops answering
	option shutdown_timeout '90'
	option shutdown_grace '10'
	option stagger_ms '1000'
	option ssh_user 'root'
	# Serial console servers (shared access, recent log in /var/log/nodectl)
	option console '1'
	option console_log_kb '512'
	# Console archive on the eMMC: a file per node boot under
	# console_archive_dir/nodeN, lines stamped with the BMC time; the
	# oldest boots go above console_archive_mb or console_archive_boots
	option console_archive '1'
	option console_archive_dir '/overlay/log/nodectl'
	option console_archive_mb '512'
	option console_archive_boots '100'
	option console_archive_part_mb '32'
	option console_archive_stamp '1'
	# Link capabilities of the nodes (Blade 3: Gen3 x2); status shows a
	# link that trained below these and the switch port's as degraded.
	# nodectl never reads node config space (it can wedge the root port).
	option ep_max_gen '3'
	option ep_max_width '2'
	# Chassis fan duty, percent
	option fan_duty '85'

# Per node: ipaddr + check_port decide "reachable" (TCP connect to the port,
# 50000 = Talos API; 0 = ICMP ping). baud/tty override the serial console.
config node 'node1'
	option name 'blade1'
	option autostart '1'
	option check_port '50000'
	option baud '1500000'

config node 'node2'
	option name 'blade2'
	option autostart '1'
	option check_port '50000'
	option baud '1500000'

config node 'node3'
	option name 'blade3'
	option autostart '1'
	option check_port '50000'
	option baud '1500000'

config node 'node4'
	option name 'blade4'
	option autostart '1'
	option check_port '50000'
	option baud '1500000'
