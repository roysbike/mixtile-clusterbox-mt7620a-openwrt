unset FAILSAFE
[ -e /tmp/.failsafe ] && export FAILSAFE=1

[ -f /etc/banner ] && cat /etc/banner
[ -n "$FAILSAFE" ] && [ -f /etc/banner.failsafe ] && cat /etc/banner.failsafe

if grep -Fsq '/ overlay ro,' /proc/mounts ; then
cat << EOF

 === WARNING! ======================================
 Your JFFS2-partition seems full and overlayfs is
 mounted as READ-ONLY!
 Please try to remove files from /overlay/upper/...
 and reboot!
 ---------------------------------------------------

EOF
fi

export PATH="%PATH%"
HOME=$(grep -E "^${USER:-root}:" /etc/passwd | cut -d ":" -f 6)
HOME=${HOME:-/root}
export HOME
export PS1='\[\e[36;1m\]\u@\[\e[36;1m\]\h\[\e[32;1m\]:\[\e[34;1m\]\w\[\e[m\]\$ '
export ENV=/etc/shinit
alias nodectl='sudo nodectl'
alias reboot='sudo reboot'

_nodectl()
{
    COMPREPLY=()
    local cur=${COMP_WORDS[COMP_CWORD]};
    local cmd=${COMP_WORDS[COMP_CWORD-1]};
    if [[ "$cmd" == *nodectl ]];then
        COMPREPLY=( $(compgen -W 'status list poweron poweroff shutdown reboot reset flash console ssh rescan' -- $cur) )
	else
		case $cmd in
			'status'|'poweron'|'poweroff'|'shutdown'|'reboot')
				COMPREPLY=( $(compgen -W '--all -n' -- $cur) ) ;;
			'reset'|'flash'|'console'|'ssh')
				COMPREPLY=( $(compgen -W '-n' -- $cur) ) ;;
			'-f')
				COMPREPLY=( $( compgen -A file )) ;;
		esac
	fi
    return 0
}
complete -F _nodectl nodectl

case "$TERM" in
	xterm*|rxvt*)
		export PS1='\[\e]0;\u@\h: \w\a\]'"$PS1"
	;;
esac

if [ -z "$FAILSAFE" ] ; then
	for FILE in /etc/profile.d/*.sh ; do
		[ -f "${FILE%.sh}.hush" ] && continue
		[ -f "$FILE" ] && . "$FILE"
	done
	unset FILE
fi
