#!/bin/sh /etc/rc.common
# /www/moci/version.txt: a hash of the web files. index.html reads it past
# the browser cache and puts it into every URL, so a firmware update (or
# an add-on installed later: "/etc/init.d/moci-version start") is seen at
# once. Written only when it changes.

START=49

start() {
	local v
	v=$(find /www/moci -type f \( -name '*.html' -o -name '*.js' -o -name '*.css' -o -name '*.json' \) |
		sort | xargs cat 2>/dev/null | md5sum | cut -c1-12)
	[ -n "$v" ] || return 0
	[ "$(cat /www/moci/version.txt 2>/dev/null)" = "$v" ] || echo "$v" > /www/moci/version.txt
}
