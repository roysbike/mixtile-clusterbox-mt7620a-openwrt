# MoCI sections on the ClusterBox BMC: no radio, no QoS/DDNS/LEDs; the
# cluster pages come from the add-on moci-app-clusterbox (patch 006 takes
# the matching tabs out of the pages).
config ui 'features'
	option dashboard '1'
	option network '1'
	option wireless '0'
	option firewall '1'
	option dhcp '1'
	option dns '1'
	option wireguard '1'
	option qos '0'
	option ddns '0'
	option diagnostics '1'
	option system '1'
	option backup '1'
	option packages '1'
	option services '1'
	option ssh_keys '1'
	option storage '1'
	option leds '0'
	option firmware '1'
	option addons '1'
