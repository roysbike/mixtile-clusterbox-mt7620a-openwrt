+.login-fw a { color: var(--steel-muted); text-decoration: underline; text-underline-offset: 3px; }
+.login-fw a:hover { color: var(--starship-steel); }
+.form-hint { margin-top: 10px; font-size: 12.5px; color: var(--steel-muted); }
+.backup-progress { margin-top: 16px; }
+.progress-fill.busy { background-image: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent); background-size: 200% 100%; animation: moci-busy 1.2s linear infinite; }
+@keyframes moci-busy { from { background-position: 200% 0; } to { background-position: -200% 0; } }
+@media (prefers-reduced-motion: reduce) { .progress-fill.busy { animation: none; } }
+.addon-section + .addon-section, .tab-content > .stat-card + .addon-section, .addon-section + .stat-card { margin-top: 16px; }
