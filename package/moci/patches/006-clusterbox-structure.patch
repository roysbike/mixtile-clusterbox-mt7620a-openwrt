+	// Firmware version under the login form, with a link to its release
+	// (a development build links to its commit). /moci/firmware.json is
+	// written at boot from /etc/mixtile-release and needs no session.
+	async showFirmwareFooter() {
+		const el = document.getElementById('login-fw');
+		if (!el) return;
+		try {
+			const res = await fetch('/moci/firmware.json', { cache: 'no-store' });
+			if (!res.ok) return;
+			const fw = await res.json();
+			const repo = /^[\w.-]+\/[\w.-]+$/.test(fw.repository || '') ? fw.repository : '';
+			const release = /^v\d+\.\d+\.\d+(-rc\.\d+)?$/.test(fw.version || '');
+			const href = !repo ? '' : release ? `https://github.com/${repo}/releases/tag/${fw.version}`
+				: /^[0-9a-f]{7,40}$/.test(fw.commit || '') ? `https://github.com/${repo}/commit/${fw.commit}` : `https://github.com/${repo}/releases`;
+			const label = `Firmware ${fw.version || '?'}${fw.openwrt ? ` · OpenWrt ${fw.openwrt}` : ''}`;
+			el.innerHTML = href
+				? `<a href="${this.escapeHtml(href)}" target="_blank" rel="noopener">${this.escapeHtml(label)}</a>`
+				: this.escapeHtml(label);
+		} catch {}
+	}
+
+	// Sections that add-ons put into a tab of a MoCI page (extension point
+	// "tab:section": {id, page, tab, position: 'top'|'bottom', render(el)}),
+	// rendered every time the tab is shown.
+	renderSections(page, tab) {
+		for (const ext of this.getExtensions('tab:section')) {
+			if (ext.page !== page || ext.tab !== tab || !/^[a-z0-9-]+$/.test(ext.id || '')) continue;
+			const host = document.getElementById(`tab-${tab}`);
+			if (!host || typeof ext.render !== 'function') continue;
+			let el = document.getElementById(`section-${ext.id}`);
+			if (!el) {
+				el = document.createElement('div');
+				el.id = `section-${ext.id}`;
+				el.className = 'addon-section';
+				if (ext.position === 'top') host.prepend(el);
+				else host.appendChild(el);
+			}
+			try {
+				ext.render(el);
+			} catch (err) {
+				console.error(`Section ${ext.id} failed:`, err);
+			}
+		}
+	}
+
+	// Wrap a page's tab handlers so that add-on sections follow each tab.
+	withSections(page, handlers) {
+		for (const tab of Object.keys(handlers)) {
+			const load = handlers[tab];
+			handlers[tab] = () => {
+				const r = load();
+				this.renderSections(page, tab);
+				return r;
+			};
+		}
+		return handlers;
+	}
