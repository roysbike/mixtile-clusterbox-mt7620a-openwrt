Fresh web files after a firmware update: uhttpd sends no Cache-Control,
so the browser kept old scripts under the same URLs. index.html loads
version.txt (a hash of the web files, written at boot by
/etc/init.d/moci-version) past the cache, moves to /moci/?v=<hash> when
the page is older, and loads app.css and core.js with ?v=; core.js adds
it to modules, add-ons and their stylesheets.

--- a/moci/index.html
+++ b/moci/index.html
@@ -14,7 +14,8 @@
 		<meta name="apple-mobile-web-app-capable" content="yes" />
 		<meta name="apple-mobile-web-app-status-bar-style" content="black" />
 		<link rel="apple-touch-icon" href="icons/icon-192.png" />
-		<link rel="stylesheet" href="app.css" />
+		<!-- app.css comes with the version from the loader below; hidden until then. -->
+		<style id="moci-loading">body { visibility: hidden; }</style>
 	</head>
 	<body>
 		<div id="app">
@@ -2512,9 +2513,29 @@
 		</div>
 
 		<script type="module">
-			import { OpenWrtCore } from './js/core.js';
-			window.app = new OpenWrtCore();
-			window.app.init();
+			// uhttpd sends no Cache-Control: after a firmware update the
+			// browser would keep the old scripts. version.txt (a hash of the
+			// web files, written at boot) is read past the cache and goes
+			// into every URL, this page's own included.
+			let v = '';
+			try {
+				const r = await fetch('/moci/version.txt', { cache: 'no-store' });
+				if (r.ok) v = (await r.text()).trim();
+			} catch {}
+			const q = new URLSearchParams(location.search);
+			if (/^[0-9a-f]+$/.test(v) && q.get('v') !== v) {
+				q.set('v', v);
+				location.replace(`${location.pathname}?${q}${location.hash}`);
+			} else {
+				const css = document.createElement('link');
+				css.rel = 'stylesheet';
+				css.href = `app.css?v=${v}`;
+				css.onload = css.onerror = () => document.getElementById('moci-loading')?.remove();
+				document.head.appendChild(css);
+				const { OpenWrtCore } = await import(`./js/core.js?v=${v}`);
+				window.app = new OpenWrtCore();
+				window.app.init();
+			}
 		</script>
 	</body>
 </html>
