{
	"luci-app-nodectl": {
		"description": "Grant access to Blade3 node control",
		"read": {
			"ubus": {
				"nodectl": [ "status", "log", "console_log", "leases", "pubkey", "pxe" ]
			},
			"file": {
				"/opt/pxe/*": [ "read" ]
			},
			"uci": [ "nodectl", "dhcp" ]
		},
		"write": {
			"ubus": {
				"nodectl": [ "action", "rescan", "console", "send", "fan", "flash", "pxe_delete", "pxe_enable" ]
			},
			"file": {
				"/opt/pxe/*": [ "write" ]
			},
			"uci": [ "nodectl", "dhcp" ]
		}
	}
}
