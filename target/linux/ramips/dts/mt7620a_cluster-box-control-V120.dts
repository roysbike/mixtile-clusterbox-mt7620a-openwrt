#include "mt7620a.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
    compatible = "cluster-box-control-V120","cluster-box-control","ralink,mt7620a-evb", "ralink,mt7620a-soc";
	model = "MC-CLUSTERBOX";

	chosen {
		//bootargs = "console=ttyS0,115200";
		bootargs = "console=ttyS0,115200 root=/dev/mmcblk0p2 rootwait rw";
	};

	/delete-node/ wmac@10180000;

	aliases {
		led-boot = &led_system;
		led-failsafe = &led_system;
		led-running = &led_system;
		led-upgrade = &led_system;
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio2 26 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_system: system {
			label = "blue:system";
			gpios = <&gpio2 27 GPIO_ACTIVE_LOW>;
		};
    };

	gpio_export {
		compatible = "gpio-export";
		#size-cells = <0>;

		EXT_EN {
			gpio-export,name = "ext_en_power";
			gpio-export,output = <1>;
			gpios = <&gpio2 30 GPIO_ACTIVE_HIGH>;
		};
	};

	/* Fans: software PWM on GPIO (Linux pwm-gpio), one chip per fan:
	 * pwmchip0/pwm0 = fan1, pwmchip1/pwm0 = fan2 (fan-boot, nodectl).
	 * The tachometer lines (gpio2 21/20) are not used.
	 */
	fan1: pwm-fan1 {
		compatible = "pwm-gpio";
		#pwm-cells = <3>;
		gpios = <&gpio2 23 GPIO_ACTIVE_HIGH>;
	};

	fan2: pwm-fan2 {
		compatible = "pwm-gpio";
		#pwm-cells = <3>;
		gpios = <&gpio2 22 GPIO_ACTIVE_HIGH>;
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <80000000>;
		m25p,fast-read;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x30000 0x10000>;
				read-only;
			};

			partition@40000 {
				label = "factory";
				reg = <0x40000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_factory_4: macaddr@4 {
						reg = <0x4 0x6>;
					};
				};
			};
		};
	};
};

&ethernet {
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>, <&rgmii1_pins>;

	nvmem-cells = <&macaddr_factory_4>;
	nvmem-cell-names = "mac-address";

	mediatek,portmap = "llllw";

	port@5 {
		status = "okay";
		phy-handle = <&phy1>;
		phy-mode = "rgmii";
	};

	mdio-bus {
		status = "okay";

		phy1: ethernet-phy@1 {
			reg = <1>;
			phy-mode = "rgmii";
		};
	};
};

&gsw {
	mediatek,ephy-base = /bits/ 8 <12>;
};

&sdhci {
	status = "okay";
};

&ehci {
	status = "okay";
};

&ohci {
	status = "okay";
};

&pcie {
	status = "okay";
};


&state_default {
	gpio {
		groups = "uartf", "wled", "rgmii2";
		function = "gpio";
	};
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&gpio3 {
	status = "okay";
};

&i2c {
	status = "okay";

	pcf8563: pcf8563@51 {
		compatible = "haoyu,hym8563";
		status = "okay";
		reg = <0x51>;
	};

	pca955500: pca95550@24 {
		compatible = "nxp,pca9555";
		status = "okay";
		reg = <0x24>;
	};
};
